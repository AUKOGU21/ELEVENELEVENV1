{
  "manifest_version": 3,
  "name": "ElevenEleven",
  "short_name": "ElevenEleven",
  "description": "Still second-guessing? Turn any product page into a conversation. Add it to ELEVENELEVEN in one click and get firsthand advice.",
  "version": "1.0.0",
  "homepage_url": "https://geteleveneleven.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Post to ElevenEleven",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
